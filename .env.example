# Server-only settings. Never prefix with NEXT_PUBLIC_ or VITE_.
# On Vercel, set these in Project → Settings → Environment Variables.

# Answer model: Atria Dawn Preview (key from https://api.atria-asi.ai/console/keys).
MODEL_BASE_URL=https://api.atria-asi.ai/v1
MODEL_ID=Atria-Dawn-Preview
MODEL_DISPLAY_NAME=Atria Dawn Preview
MODEL_API_KEY=

# Research engines. The Vision agent needs Kernel.
KERNEL_API_KEY=
BROWSER_USE_API_KEY=
# Tavily Search API (free monthly credits at https://app.tavily.com): finds the pages Kernel and the
# Vision agent read. Search engines block cloud browsers or send them unrelated results.
TAVILY_API_KEY=

# AI/ML API: JEV routing, and the vision model (photos, Vision agent).
AIMLAPI_API_KEY=
# Check the exact ID in AI/ML API's model list.
VISION_MODEL_ID=deepseek/deepseek-v4.1-flash

# Require this code in the app before anyone can use your keys.
SCOUT_ACCESS_CODE=

# Optional, usually not needed:
# TYPESAFE_API_KEY=        JEV straight from TypeSafe instead of AI/ML API
# VISION_MODEL_BASE_URL=   defaults to https://api.aimlapi.com/v1
# VISION_MODEL_API_KEY=    defaults to AIMLAPI_API_KEY
# RESEARCH_MAX_COST_USD=2  money cap for one research's Browser Use run; research has no time limit
# SCOUT_DURABLE_RESEARCH=off  keep research inside the chat request (200 s budget) even on Vercel
